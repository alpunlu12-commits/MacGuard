<Window x:Class="MacGuard.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacGuard" Width="900" Height="780" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="{StaticResource Background}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">

            <!-- Durum başlığı -->
            <Border Style="{StaticResource CardHi}" Padding="20" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="92" Height="92">
                        <Ellipse x:Name="HaloFill" />
                        <Ellipse x:Name="Ring" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RingScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="38"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="M A C G U A R D" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="Headline" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock x:Name="Subline" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Kamera erişimi kapalıyken ne yapılacağını anlatan uyarı -->
            <Border x:Name="CameraBanner" Style="{StaticResource CardHi}" BorderBrush="#80FBBF24" Padding="14"
                    Margin="0,0,0,22" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="20"
                               Foreground="{StaticResource Arming}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="CameraStatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                   Text="Hareket ve yakınlık algılama kamerayı kullanır. Windows Ayarları &gt; Gizlilik ve güvenlik &gt; Kamera altında &quot;Masaüstü uygulamalarının kameranıza erişmesine izin ver&quot; açık olmalı. Görüntü bilgisayarından çıkmaz." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="CameraRetry" Style="{StaticResource SmallButton}" Content="Yeniden dene" />
                        <Button x:Name="CameraSettings" Style="{StaticResource SmallButton}" Margin="0"
                                Content="Windows Ayarları" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Eylem düğmeleri -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MainAction" Style="{StaticResource PrimaryButton}" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="ActionNote" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" MinHeight="0" Visibility="Collapsed" />
                <Button x:Name="SideAction" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Width="54"
                        Padding="0" Margin="12,0,0,0" ToolTip="Ayarlar">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="17" />
                </Button>
            </Grid>

            <!-- Önceki oturumdan kalan kapak ayarı -->
            <Border x:Name="LeftoverBar" Style="{StaticResource CardHi}" BorderBrush="#99EF4444" Padding="12"
                    Margin="0,0,0,22" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Danger}"
                               Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Kapak ayarı değiştirilmiş hâlde kalmış" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="Önceki oturum düzgün kapanmamış. Düzeltilmezse kapak kapandığında bilgisayar uyumaz ve pil biter." />
                    </StackPanel>
                    <Button x:Name="FixLeftover" Grid.Column="2" Style="{StaticResource SmallButton}" Margin="0"
                            Content="Düzelt" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Test için ses kısılmışsa çekim öncesi fark edilsin diye kalıcı uyarı -->
            <Border x:Name="TestVolumeBar" Style="{StaticResource CardHi}" BorderBrush="#80FBBF24" Padding="12"
                    Margin="0,0,0,22" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE993;" Foreground="{StaticResource Arming}"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="TestVolumeText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="FullVolume" Grid.Column="2" Style="{StaticResource SmallButton}" Margin="0"
                            Content="%100 yap" />
                </Grid>
            </Border>

            <Border x:Name="MessageBar" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,22"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Tetikleyiciler -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Tetikleyiciler" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Hangi durumda alarm çalsın?" Style="{StaticResource Secondary}" Margin="0,2,0,12" />
                <UniformGrid x:Name="SensorGrid" Columns="3" Margin="-6" />
            </StackPanel>

            <!-- Canlı kamera okuması -->
            <StackPanel x:Name="MetersSection" Margin="0,0,0,22" Visibility="Collapsed">
                <TextBlock Text="Canlı kamera okuması" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Hareket alarmı için iki çubuk da eşiği geçmeli" Style="{StaticResource Secondary}"
                           Margin="0,2,0,12" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel x:Name="MetersPanel" />
                </Border>
            </StackPanel>

            <!-- Olay kaydı -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Olay kaydı" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Son hareketler" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="PhotosButton" Grid.Column="1" Style="{StaticResource LinkButton}"
                        Foreground="{StaticResource Safe}" Margin="0,0,14,0" Visibility="Collapsed" />
                <Button x:Name="ClearLog" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Temizle" />
            </Grid>
            <Border x:Name="EmptyLog" Style="{StaticResource Card}" Padding="16">
                <TextBlock Text="Henüz kayıt yok." Foreground="{StaticResource TextSecondary}" />
            </Border>
            <Border x:Name="LogCard" Style="{StaticResource Card}">
                <StackPanel x:Name="LogList" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
