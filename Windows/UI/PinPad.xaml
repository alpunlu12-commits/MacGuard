<UserControl x:Class="MacGuard.UI.PinPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" IsTabStop="True">
    <Border CornerRadius="20" Background="#73000000" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="16" FontWeight="SemiBold" Foreground="#D9FFFFFF" Margin="0,0,0,18" />

            <!-- Girilen hane sayısını gösteren noktalar -->
            <ItemsControl x:Name="Dots" HorizontalAlignment="Center" Height="20" Margin="0,0,0,10">
                <ItemsControl.RenderTransform>
                    <TranslateTransform x:Name="Shake" />
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="StatusRow" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
            </StackPanel>

            <UniformGrid x:Name="Keys" Columns="3" Rows="4" Margin="-6,6,-6,-6" />
        </StackPanel>
    </Border>
</UserControl>
