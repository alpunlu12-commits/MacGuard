<Window x:Class="MacGuard.UI.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MacGuard.UI"
        Title="MacGuard" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A121A" Offset="0" />
                <GradientStop Color="Black" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Nefes alan yeşil hale: "izleniyor" hissi, panik değil. -->
        <Rectangle x:Name="Glow" Opacity="0.4">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.6" RadiusY="0.8">
                    <GradientStop Color="#2234D399" Offset="0" />
                    <GradientStop Color="#0034D399" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1"
                                             Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <Viewbox StretchDirection="DownOnly" Margin="60">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel MaxWidth="560" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <TextBlock Style="{StaticResource Icon}" FontSize="46" Foreground="{StaticResource Safe}"
                                   Text="&#xEA18;" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="M A C G U A R D" FontSize="12" FontWeight="Bold" Foreground="#CC34D399" />
                            <TextBlock Text="KİLİT ALTINDA" FontFamily="{StaticResource DisplayFont}" FontSize="44"
                                       FontWeight="Black" Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="LockText" FontSize="19" Foreground="#E0FFFFFF" TextWrapping="Wrap"
                               LineHeight="30" Margin="0,0,0,26" />

                    <!-- Hangi sensörlerin nöbette olduğunu açıkça göster:
                         caydırıcılık bilginin somut olmasından geliyor. -->
                    <StackPanel x:Name="SensorsPanel" Margin="0,0,0,26">
                        <TextBlock Text="AKTİF SENSÖRLER" FontSize="10.5" FontWeight="Bold" Foreground="#66FFFFFF"
                                   Margin="0,0,0,8" />
                        <WrapPanel x:Name="SensorChips" />
                    </StackPanel>

                    <TextBlock x:Name="Signature" FontSize="11" FontWeight="Medium" Foreground="#52FFFFFF"
                               Margin="0,0,0,18" />

                    <Border x:Name="PreviewBadge" CornerRadius="14" Background="#24FBBF24" Padding="12,7"
                            HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Text="ÖNİZLEME — koruma aktif değil" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Arming}" />
                    </Border>

                    <StackPanel x:Name="GuardedRow" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" Foreground="#D934D399"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="GuardedText" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   FontWeight="Medium" Foreground="#D934D399" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="310" VerticalAlignment="Center">
                    <ui:PinPad x:Name="Pad" />
                    <Button x:Name="ClosePreview" Style="{StaticResource PrimaryButton}" Background="{StaticResource Idle}"
                            MinHeight="40" Margin="0,14,0,0" Visibility="Collapsed" Content="Önizlemeyi kapat" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
